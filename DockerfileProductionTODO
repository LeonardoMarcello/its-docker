ARG ROS_DISTRO=humble

# ==========================================
# STAGE 1: COAL BUILDER
# ==========================================
FROM ros:${ROS_DISTRO}-ros-core AS coal_builder
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git \
    libeigen3-dev libboost-all-dev liboctomap-dev \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --recursive https://github.com/coal-library/coal.git /tmp/coal && \
    cd /tmp/coal && mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc) && \
    make install DESTDIR=/coal_staging

# ==========================================
# STAGE 2: WORKSPACE BUILDER
# ==========================================
FROM ros:${ROS_DISTRO}-ros-core AS ws_builder
ENV DEBIAN_FRONTEND=noninteractive

# Install build tools AND ROS dependencies needed to compile your code
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git python3-colcon-common-extensions \
    libeigen3-dev libboost-all-dev liboctomap-dev \
    ros-$ROS_DISTRO-rviz2 ros-$ROS_DISTRO-xacro \
    ros-$ROS_DISTRO-robot-state-publisher ros-$ROS_DISTRO-tf2 \
    ros-$ROS_DISTRO-tf2-ros ros-$ROS_DISTRO-tf2-geometry-msgs \
    ros-$ROS_DISTRO-rmw-cyclonedds-cpp \
    && rm -rf /var/lib/apt/lists/*

# Copy coal from Stage 1 so colcon can link against it
COPY --from=coal_builder /coal_staging/usr/local /usr/local
RUN ldconfig

WORKDIR /ros2_ws
# Copy your host's src folder into the builder
COPY src/ src/

# Build the workspace (Notice: NO --symlink-install here!)
RUN /bin/bash -c "source /opt/ros/$ROS_DISTRO/setup.bash && colcon build"

# ==========================================
# STAGE 3: PRODUCTION RUNTIME
# ==========================================
FROM ros:${ROS_DISTRO}-ros-core

ARG USER=its
ARG UID=1000
ARG GID=1000
ENV DEBIAN_FRONTEND=noninteractive

# Install ONLY runtime dependencies (No build-essential, cmake, git, colcon)
# Note: We install standard libboost, not libboost-all-dev
RUN apt-get update && apt-get install -y --no-install-recommends \
    locales sudo wget curl xvfb freeglut3-dev \
    libboost-system1.74.0 libboost-thread1.74.0 \
    ros-$ROS_DISTRO-rviz2 ros-$ROS_DISTRO-xacro \
    ros-$ROS_DISTRO-robot-state-publisher ros-$ROS_DISTRO-tf2 \
    ros-$ROS_DISTRO-tf2-ros ros-$ROS_DISTRO-tf2-geometry-msgs \
    ros-$ROS_DISTRO-rmw-cyclonedds-cpp \
    && rm -rf /var/lib/apt/lists/*

# 1. Grab compiled coal from Stage 1
COPY --from=coal_builder /coal_staging/usr/local /usr/local
RUN ldconfig

# Create your non-root user
RUN groupadd -g ${GID} ${USER} || true && \
    useradd -m -u ${UID} -g ${GID} -s /bin/bash ${USER} || true && \
    echo "${USER} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USER}

USER ${USER}
ENV HOME=/home/${USER}
WORKDIR ${HOME}/ros2_ws

# 2. Grab your compiled ROS workspace from Stage 2
# We use --chown to ensure the 'its' user owns these files, not root
COPY --chown=${USER}:${USER} --from=ws_builder /ros2_ws/install install/

# Setup entrypoint and .bashrc
COPY --chown=root:root docker/entrypoint.sh /entrypoint.sh
RUN sudo chmod +x /entrypoint.sh

RUN echo "source /opt/ros/$ROS_DISTRO/setup.bash" >> ~/.bashrc && \
    echo "source ${HOME}/ros2_ws/install/setup.bash" >> ~/.bashrc

ENTRYPOINT ["/entrypoint.sh"]
# Update this CMD to launch your actual main production node!
CMD ["ros2", "launch", "my_package", "my_launch_file.launch.py"]
