<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fingertip">

  <!-- Parameters: mesh path and frame names -->
  <xacro:arg name="mesh_file"    default="package://its_ros2/meshes/digitac_skin.stl"/>  <!-- Location of the mesh .stl -->
  <xacro:arg name="finger_frame" default="fingertip"/>                                <!-- Name of the finger frame  -->
  <xacro:arg name="fix_on_world" default="true"/>                                <!-- Name of the finger frame  -->

  <!-- World anchor -->
  <link name="world"/>

  <!-- Fingertip link -->
  <link name="$(arg finger_frame)">
    <visual>
      <geometry>
        <mesh filename="$(arg mesh_file)" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="skin">
        <color rgba="0.9 0.75 0.6 0.8"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="$(arg mesh_file)" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- Fixed joint: world → fingertip (only when fix_on_world:=true) -->
  <xacro:if value="$(arg fix_on_world)">
    <joint name="world_to_fingertip" type="fixed">
      <parent link="world"/>
      <child  link="$(arg finger_frame)"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:if>

</robot>
